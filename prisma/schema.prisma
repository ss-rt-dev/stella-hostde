generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  passwordHash  String
  role          Role           @default(CUSTOMER)
  balance       Decimal        @default(0) @db.Decimal(12, 2)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  servers       Server[]
  transactions  Transaction[]
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  CUSTOMER
  ADMIN
}

model Package {
  id                 String   @id @default(cuid())
  name               String
  description        String?
  cpu                Int
  ramMb              Int
  diskGb             Int
  pricePerHour       Decimal  @db.Decimal(10, 4)
  proxmoxTemplateId  String
  node               String   @default("pve")
  storage            String   @default("auto")
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  servers            Server[]
}

model Server {
  id              String       @id @default(cuid())
  accessSlug      String?      @unique
  userId          String
  packageId       String
  proxmoxVmid     Int?
  name            String
  status          ServerStatus @default(CREATING)
  ipAddress       String?
  hostname        String?
  cpu             Int?
  ramMb           Int?
  diskGb          Int?
  pricePerHour    Decimal?     @db.Decimal(10, 4)
  // DEBIAN | MINECRAFT | DISCORD_BOT
  serverType      String       @default("DEBIAN")
  // paper | vanilla | purpur | fabric | spigot | python | nodejs
  softwareVariant String?
  softwareVersion String?
  discountCode    String?
  setupStatus     String?      // pending | running | done | failed | skipped
  setupNote       String?
  createdAt       DateTime     @default(now())
  lastBilledAt    DateTime     @default(now())
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  package         Package      @relation(fields: [packageId], references: [id])
}

enum ServerStatus {
  CREATING
  RUNNING
  STOPPED
  DELETED
  ERROR
}

model Transaction {
  id            String          @id @default(cuid())
  userId        String
  type          TransactionType
  amount        Decimal         @db.Decimal(12, 2)
  description   String?
  paypalOrderId String?
  createdAt     DateTime        @default(now())
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum TransactionType {
  DEPOSIT
  PURCHASE
  HOURLY_CHARGE
  REFUND
}
