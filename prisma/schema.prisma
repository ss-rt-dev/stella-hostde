generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                @id @default(cuid())
  email                String                @unique
  name                 String?
  passwordHash         String
  role                 Role                  @default(CUSTOMER)
  balance              Decimal               @default(0) @db.Decimal(12, 2)
  onboardingDone       Boolean               @default(false)
  lastLoginAt          DateTime?
  lastLoginIp          String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  servers              Server[]
  transactions         Transaction[]
  accounts             Account[]
  sessions             Session[]
  activities           ActivityLog[]
  supportTickets       SupportTicket[]
  supportMessages      SupportMessage[]
  todosCreated         Todo[]                @relation("TodoCreator")
  todosAssigned        Todo[]                @relation("TodoAssignee")
  todoAssignments      TodoAssignee[]
  announcements        TeamAnnouncement[]
  ownedTeams           Team[]                @relation("TeamOwner")
  memberships          TeamMember[]
  channelMemberships   TeamChannelMember[]
  channelMessages      TeamChannelMessage[]
  channelsCreated      TeamChannel[]         @relation("ChannelCreator")
  platformAnnouncements PlatformAnnouncement[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  CUSTOMER
  VIP
  SPONSOR
  PARTNER
  SUPPORTER
  MODERATOR
  ADMIN
}

model Package {
  id                String   @id @default(cuid())
  name              String
  description       String?
  cpu               Int
  ramMb             Int
  diskGb            Int
  pricePerHour      Decimal  @db.Decimal(10, 4)
  proxmoxTemplateId String
  node              String   @default("pve")
  storage           String   @default("auto")
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  servers           Server[]
}

model Server {
  id              String       @id @default(cuid())
  accessSlug      String?      @unique
  userId          String
  packageId       String
  proxmoxVmid     Int?
  name            String
  status          ServerStatus @default(CREATING)
  ipAddress       String?
  hostname        String?
  cpu             Int?
  ramMb           Int?
  diskGb          Int?
  pricePerHour    Decimal?     @db.Decimal(10, 4)
  serverType      String       @default("DEBIAN")
  softwareVariant String?
  softwareVersion String?
  discountCode    String?
  setupStatus     String?
  setupNote       String?
  createdAt       DateTime     @default(now())
  lastBilledAt    DateTime     @default(now())
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  package         Package      @relation(fields: [packageId], references: [id])
}

enum ServerStatus {
  CREATING
  RUNNING
  STOPPED
  DELETED
  ERROR
}

model Transaction {
  id            String          @id @default(cuid())
  userId        String
  type          TransactionType
  amount        Decimal         @db.Decimal(12, 2)
  description   String?
  paypalOrderId String?
  createdAt     DateTime        @default(now())
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum TransactionType {
  DEPOSIT
  PURCHASE
  HOURLY_CHARGE
  REFUND
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  detail    String?
  meta      String?
  ip        String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
}

model DiscountCode {
  id         String    @id @default(cuid())
  code       String    @unique
  percent    Int
  label      String?
  active     Boolean   @default(true)
  maxUses    Int?
  usedCount  Int       @default(0)
  validFrom  DateTime?
  validUntil DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

enum SupportType {
  GENERAL
  SERVER
  TEAM_APPLICATION
  DISCORD
}

enum SupportStatus {
  OPEN
  CLOSED
}

model SupportTicket {
  id          String           @id @default(cuid())
  teamId      String?
  userId      String
  subject     String
  description String           @db.Text
  type        SupportType      @default(GENERAL)
  status      SupportStatus    @default(OPEN)
  discordName String?
  applyRole   String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  closedAt    DateTime?
  team        Team?            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    SupportMessage[]

  @@index([teamId, status])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String
  userId    String
  body      String        @db.Text
  isStaff   Boolean       @default(false)
  createdAt DateTime      @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

enum TeamMemberRole {
  OWNER
  ADMIN
  MEMBER
}

model Team {
  id             String             @id @default(cuid())
  name           String
  inviteCode     String             @unique
  ownerId        String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  owner          User               @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members        TeamMember[]
  todos          Todo[]
  announcements  TeamAnnouncement[]
  supportTickets SupportTicket[]
  channels       TeamChannel[]

  @@index([ownerId])
}

model TeamMember {
  id       String         @id @default(cuid())
  teamId   String
  userId   String
  role     TeamMemberRole @default(MEMBER)
  /** Anzeige-Rolle nur im Team (z.B. Moderator) – nicht die globale User-Rolle */
  title    String?
  joinedAt DateTime       @default(now())
  team     Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

model TeamChannel {
  id          String               @id @default(cuid())
  teamId      String
  name        String
  description String?
  createdById String
  isDefault   Boolean              @default(false)
  createdAt   DateTime             @default(now())
  team        Team                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy   User                 @relation("ChannelCreator", fields: [createdById], references: [id], onDelete: Cascade)
  members     TeamChannelMember[]
  messages    TeamChannelMessage[]

  @@index([teamId, createdAt])
}

model TeamChannelMember {
  id        String      @id @default(cuid())
  channelId String
  userId    String
  joinedAt  DateTime    @default(now())
  channel   TeamChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId])
}

model TeamChannelMessage {
  id        String      @id @default(cuid())
  channelId String
  userId    String
  body      String      @db.Text
  createdAt DateTime    @default(now())
  channel   TeamChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
}

/** Plattform-weite Ankündigungen (Admin) – oben im User-Dashboard */
model PlatformAnnouncement {
  id        String   @id @default(cuid())
  title     String
  body      String   @db.Text
  active    Boolean  @default(true)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([active, createdAt])
}

enum TodoStatus {
  OPEN
  IN_PROGRESS
  DONE
}

enum TodoPriority {
  LOW
  MEDIUM
  HIGH
}

enum TodoScope {
  PERSONAL
  TEAM
}

model Todo {
  id          String         @id @default(cuid())
  teamId      String
  title       String
  description String?        @db.Text
  status      TodoStatus     @default(OPEN)
  priority    TodoPriority   @default(MEDIUM)
  scope       TodoScope      @default(PERSONAL)
  assigneeId  String?
  createdById String
  dueAt       DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  team        Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  assignee    User?          @relation("TodoAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy   User           @relation("TodoCreator", fields: [createdById], references: [id], onDelete: Cascade)
  assignees   TodoAssignee[]
  subtasks    TodoSubtask[]

  @@index([teamId, status])
  @@index([assigneeId, status])
  @@index([createdById, scope])
}

model TodoAssignee {
  id     String @id @default(cuid())
  todoId String
  userId String
  todo   Todo   @relation(fields: [todoId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([todoId, userId])
  @@index([userId])
}

model TodoSubtask {
  id        String   @id @default(cuid())
  todoId    String
  title     String
  done      Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  todo      Todo     @relation(fields: [todoId], references: [id], onDelete: Cascade)

  @@index([todoId, sortOrder])
}

model TeamAnnouncement {
  id        String   @id @default(cuid())
  teamId    String
  title     String
  body      String   @db.Text
  authorId  String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([teamId, createdAt])
}
