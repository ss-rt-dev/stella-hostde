# Datenbank (Neon / Supabase / PlanetScale)
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generiere-einen-langen-zufaelligen-string"

# Proxmox
PROXMOX_HOST="https://dein-proxmox:8006"
PROXMOX_TOKEN_ID="root@pam!dashboard"
PROXMOX_TOKEN_SECRET="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# PayPal
PAYPAL_CLIENT_ID="dein-client-id"
PAYPAL_CLIENT_SECRET="dein-client-secret"
PAYPAL_MODE="sandbox"   # oder "live"
NEXT_PUBLIC_PAYPAL_CLIENT_ID="dein-client-id"

# Cron (Vercel)
CRON_SECRET="ein-geheimes-token"
